# API Environment Variables
# Copy to .env and fill in values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/medicore?sslmode=require"

# Auth
JWT_SECRET="dev-secret-change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# App URL (for invitation links)
APP_URL="http://localhost:3000"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="medicore-documents"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@medicore.app"

# Sentry
SENTRY_DSN=""