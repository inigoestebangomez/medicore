// apps/api/prisma/schema.prisma
// MediCore Data Model — Complete Schema
// Source: docs/02-data-schema.md §3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY & TENANCY
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  oauthProvider String // "google" | "microsoft" | "credentials"
  oauthSub      String? // Subject claim del proveedor OAuth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships OrganizationMember[]
  auditLogs   AuditLog[]

  @@index([email])
  @@map("users")
}

model Organization {
  id                    String             @id @default(uuid())
  name                  String
  slug                  String             @unique // para URLs amigables: app.medicore.com/[slug]
  type                  OrganizationType   @default(SOLO_PRACTICE)
  plan                  PlanType           @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  billingInterval       BillingInterval? // monthly | yearly; null for FREE orgs
  settings              Json               @default("{}") // configuración del workspace
  logoUrl               String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime? // soft delete

  members             OrganizationMember[]
  patients            Patient[]
  auditLogs           AuditLog[]
  consents            ConsentRecord[]
  invitations         Invitation[]
  aiReportUsages      AiReportUsage[]
  importBatches       ImportBatch[]
  researchQueries     ResearchQuery[]
  researchDashboards  Dashboard[]
  patientCollections  PatientCollection[]
  billingTransactions BillingTransaction[]
  doctorSchedules     DoctorSchedule[]
  pharmaContacts      PharmaContact[]
  pharmaInteractions  PharmaInteraction[]
  researchStudies     ResearchStudy[]
  variableTemplates   VariableTemplate[]
  studySubjects       StudySubject[]
  calendarEvents      CalendarEvent[]
  calendarTokens      CalendarToken[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole @default(PHYSICIAN)
  invitedBy      String? // userId del que invitó
  joinedAt       DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId]) // un usuario solo puede tener un rol por organización
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum OrganizationType {
  CLINIC // Clínica con varios médicos
  SOLO_PRACTICE // Médico liberal autónomo
  HOSPITAL_DEPT // Unidad hospitalaria
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum BillingType {
  CONSULTATION
  SURGERY
  TREATMENT
  SUBSCRIPTION
  OTHER
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum InteractionType {
  CALL
  MEETING
  EMAIL
  LUNCH
  CONFERENCE
  OTHER
}

// Calendar (Phase 3) — persisted CalendarEvent + tokens for external sync.
enum CalendarEventSource {
  SURGERY
  CONSULTATION
  PHARMA_INTERACTION
  MANUAL
  PUBLIC_BOOKING
  EXTERNAL_GOOGLE
  EXTERNAL_MICROSOFT
  EXTERNAL_ICLOUD
}

enum CalendarEventStatus {
  RESERVED // public booking pre-confirm
  CONFIRMED
  CANCELLED
  TENTATIVE // external mirror, not yet acknowledged
}

enum CalendarProvider {
  GOOGLE
  MICROSOFT
  APPLE
}

enum MemberRole {
  OWNER
  PHYSICIAN
  VIEWER
  ADMIN
}

model Invitation {
  id             String     @id @default(uuid())
  email          String
  tokenHash      String     @unique // SHA-256 of the invitation token
  role           MemberRole
  organizationId String
  invitedBy      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([organizationId])
  @@map("invitations")
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum IdDocumentType {
  DNI
  NIE
  PASSPORT
  OTHER
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  ANAPHYLAXIS
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  UNCONFIRMED
}

enum ConsultationType {
  FIRST_VISIT // Primera consulta
  FOLLOW_UP // Revisión
  URGENCY // Urgencia
  POST_OP // Postoperatoria
  TELECONSULTATION // Teleconsulta
}

enum SurgeryStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AsaClassification {
  ASA_I
  ASA_II
  ASA_III
  ASA_IV
  ASA_V
  ASA_VI
}

enum ImagingStudyType {
  CT_SCAN // TAC
  MRI // Resonancia magnética
  XRAY // Radiografía
  ENDOSCOPY // Endoscopia
  NASOFIBROSCOPY // Nasofibroscopia
  LARYNGOSCOPY // Laringoscopia
  AUDIOGRAM // Audiometría
  TYMPANOGRAM // Impedanciometría
  ABR // Potenciales evocados auditivos
  VIDEONYSTAGMOGRAPHY // Videonistagmografía
  VHIT // Video Head Impulse Test
  ULTRASOUND // Ecografía
  OTHER
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
  COMPLETED
  ON_HOLD
}

enum ReportType {
  DISCHARGE_SUMMARY // Informe de alta
  SURGICAL_REPORT // Informe quirúrgico
  REFERRAL_LETTER // Carta de derivación
  MEDICAL_CERTIFICATE // Certificado médico
  FOLLOW_UP_REPORT // Informe de revisión
  PATHOLOGY_REPORT // Informe de anatomía patológica
}

enum ReportStatus {
  DRAFT // Generado por IA, pendiente de revisión
  REVIEWED // Revisado por el médico
  SIGNED // Firmado (estado final)
}

enum ImportStatus {
  PENDING // análisis en curso
  CONFIRMING // esperando confirmación del médico
  PROCESSING // importando datos
  COMPLETED // importación finalizada
  FAILED // error durante la importación
}

enum ClinicalScaleType {
  SNOT_22 // Sino-Nasal Outcome Test (rinosinusitis)
  VAS_TINNITUS // Escala visual analógica para acúfenos
  DHI // Dizziness Handicap Inventory (vértigo)
  VHI // Voice Handicap Index (disfonía)
  RSI // Reflux Symptom Index
  OSA_EPWORTH // Escala de somnolencia de Epworth (SAOS)
  STOPBANG // Cuestionario STOP-BANG (apnea del sueño)
  NOSE // Nasal Obstruction Symptom Evaluation
  CUSTOM // Escala personalizada del médico
}

enum ConsentType {
  TREATMENT // Consentimiento de tratamiento general
  SURGERY // Consentimiento quirúrgico específico
  DATA_PROCESSING // Consentimiento RGPD tratamiento de datos
  PHOTOGRAPHY // Consentimiento para fotografías/vídeos clínicos
  RESEARCH // Consentimiento para uso en investigación
}

// ─────────────────────────────────────────────
// SEVEN CATEGORIES — enums (SDD patient-seven-categories)
// ─────────────────────────────────────────────

enum HistoryEntryType {
  PERSONAL
  ALLERGY
  SURGICAL
  TOXIC_HABIT
  PROFESSION
  FAMILY
  ECOG
}

enum DurationUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum ReviewState {
  UNREVIEWED
  CONFIRMED
  REJECTED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  DISCARDED
}

enum DiagnosisCodeSystem {
  CIE_10_ES // CIE-10-ES (ICD-10-CM Spanish adaptation)
  SNOMED
}

// ─────────────────────────────────────────────
// CLINICAL CORE
// ─────────────────────────────────────────────

model Patient {
  id             String @id @default(uuid())
  organizationId String
  nhc            String // Nº Historia Clínica — único por organización

  // Datos demográficos
  firstName  String?
  lastName   String?
  birthDate  DateTime? // nullable: imported records may lack birth date (no 1900-01-01 fallback)
  sex        Sex
  idDocument String? // Número del documento de identidad
  idDocType  IdDocumentType @default(DNI)

  // Contacto
  phone            String?
  email            String?
  address          Json? // { street, city, province, postalCode, country }
  emergencyContact Json? // { name, relationship, phone }

  // Clínico
  bloodType BloodType @default(UNKNOWN)
  notes     String? // Notas libres del médico sobre el paciente

  // Datos de importación (Phase 11)
  importedData  Json? // { "batch-uuid": { _batchName, _importedAt, ...customFields } }
  importSource  String? // "xlsx" | "csv" | "tsv" | "manual" (null = registro manual)
  importBatchId String? // último batch que creó o enriqueció esta ficha

  // Seven Categories — age semantics (spec §1)
  // Full reference date (day/month/year) for age when birthDate is absent.
  // Never fabricates a birth date; provenance is visible to the user.
  ageReferenceDate   Json? // { day: Int, month: Int, year: Int } | null
  ageAtReferenceDate Int? // reported age at the reference date (informational)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String // userId
  updatedBy String? // userId

  // Relaciones
  organization          Organization              @relation(fields: [organizationId], references: [id])
  allergies             Allergy[]
  importBatch           ImportBatch?              @relation(fields: [importBatchId], references: [id])
  consultations         Consultation[]
  surgeries             Surgery[]
  imagingStudies        ImagingStudy[]
  medications           MedicationPrescription[]
  reports               Report[]
  scales                ClinicalScale[]
  consents              ConsentRecord[]
  collectionMemberships PatientCollectionMember[]
  billingTransactions   BillingTransaction[]
  studySubjects         StudySubject[]
  historyEntries        PatientHistoryEntry[]
  currentIllnesses      CurrentIllnessEntry[]
  physicalExamRecords   PhysicalExamRecord[]
  labReports            LabReport[]
  diagnoses             Diagnosis[]

  @@unique([organizationId, nhc]) // El NHC es único dentro de la organización
  @@index([organizationId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, birthDate])
  @@index([organizationId, idDocument])
  @@index([organizationId, importBatchId])
  @@map("patients")
}

// ─────────────────────────────────────────────
// IMPORT (Phase 11)
// ─────────────────────────────────────────────

model ImportBatch {
  id             String @id @default(uuid())
  organizationId String
  createdBy      String // userId del médico que importó

  // Metadata del archivo original
  fileName       String
  fileSize       Int // bytes
  fileHash       String // SHA-256 para auditoría/dedup
  originalFormat String // "xlsx" | "csv" | "tsv"

  // Muestra del archivo y resultado del análisis IA
  sample           Json // { columns, rows } primeras 20 filas para UI
  // RGPD: normalized row values are persisted only to resume preview/finalize;
  // the uploaded binary buffer is never stored. Retention follows ImportBatch.
  normalizedRows   Json? // bounded by MAX_UPLOAD_BYTES; normalized values only
  columnMapping    Json // { "Nº HISTORIA": "nhc", "Edad": "age", ... }
  customFieldNames Json     @default("{}") // { "NombreColumnaOriginal": "nombre legible" }
  junkRowIndices   Int[] // índices de filas basura detectadas
  ignoredColumns   Json? // explicit physician discard metadata: column + reason
  ignoredRows      Json? // explicit physician discard metadata: rowIndex + reason
  previewOverrides Json? // bounded, physician-edited preview cells
  cellOverrides    Json? // bounded per-cell discard metadata
  aiConfidence     Float? // 0.0 - 1.0
  aiProvider       String? // "heuristic" | "groq" | "claude"
  issues           String[] @default([])
  notes            String?

  // Resultado del análisis (para la UI)
  totalRows    Int @default(0)
  // Resultado de la importación
  importedRows Int @default(0)
  enrichedRows Int @default(0)
  createdRows  Int @default(0)
  skippedRows  Int @default(0)
  pendingRows  Int @default(0)

  // Snapshot pre-import para revert (BR-IMP-005)
  snapshot Json?

  // Estado
  status       ImportStatus @default(PENDING)
  errorMessage String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  deletedAt   DateTime? // soft delete (revert)

  organization Organization @relation(fields: [organizationId], references: [id])
  patients     Patient[] // pacientes creados o enriquecidos en este batch

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("import_batches")
}

// ─────────────────────────────────────────────
// RESEARCH (Phase 12)
// ─────────────────────────────────────────────

model ResearchQuery {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  createdBy      String @map("created_by")

  name        String
  description String?

  // Source of data
  dataSource     String   @default("all_patients") // "all_patients" | "import_batch" | "manual_only" | "imported_only"
  importBatchIds String[] @default([])

  // Filters (AND/OR by filterLogic)
  filters     Json   @default("[]") // Filter[]
  filterLogic String @default("AND") // "AND" | "OR"

  // Display config
  displayFields  String[] @default([])
  visualizations String[] @default([]) // "table" | "bar_chart" | "line_chart" | "scatter" | "stats"

  // Privacy (BR-RES-001: private by default)
  sharedWith String[] @default([])

  // Research Engine V2 — sharing (view|edit permissions) kept alongside v1
  // sharedWith String[] for backward compatibility (AD-2).
  sharing Json @default("{\"users\":[],\"permission\":\"view\"}")

  // Research Engine V2 — optional link to a Dashboard (widget reference).
  dashboardId String? @map("dashboard_id")

  // Last execution
  lastRunAt    DateTime?
  lastRunCount Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  collections  PatientCollection[]
  studies      ResearchStudy[]
  dashboard    Dashboard?          @relation("DashboardWidgets", fields: [dashboardId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdBy])
  @@index([organizationId, createdAt])
  @@index([dashboardId])
  @@map("research_queries")
}

// ─────────────────────────────────────────────
// RESEARCH V2 — DASHBOARD (multi-widget research view)
// A Dashboard owns widgets; each widget references a ResearchQuery by ID plus
// a display config (chart type, position, display fields). Design AD-2: widget
// references ResearchQuery by ID + display config (live-reference, no snapshot).
// ─────────────────────────────────────────────
model Dashboard {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  createdBy      String @map("created_by")

  name        String
  description String?

  // Widgets embedded as JSON array of DashboardWidget (AD-2):
  // { id, queryId, chartType, position {x,y,w,h}, displayConfig }
  widgets Json @default("[]")

  // Layout metadata (background, grid density, theme) — sticky, non-substantive.
  layout Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  widgetsQueries ResearchQuery[] @relation("DashboardWidgets")

  @@index([organizationId])
  @@index([organizationId, createdBy])
  @@map("research_dashboards")
}

model PatientCollection {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  createdBy      String @map("created_by")

  name        String
  description String?
  queryId     String? @map("query_id")

  // BR-RES-003: locked collections are immutable (published study cohort)
  isLocked Boolean @default(false) @map("is_locked")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization              @relation(fields: [organizationId], references: [id])
  query        ResearchQuery?            @relation(fields: [queryId], references: [id])
  members      PatientCollectionMember[]

  @@index([organizationId])
  @@index([organizationId, createdBy])
  @@map("patient_collections")
}

// ─────────────────────────────────────────────
// RESEARCH V3 — ResearchStudy + StudyNotification (M8)
// Live cohort wrapper around an immutable ResearchQuery (composition via FK).
// BR-RES-008: auto-recalculate on import completion (stale cache > 6h).
// BR-RES-009: only the owner can freeze a study (irreversible).
// ─────────────────────────────────────────────

enum StudyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  FROZEN
}

// ─────────────────────────────────────────────
// RESEARCH V4 — Form Builder enums (REQ-FB-001, REQ-FB-008, REQ-FB-010)
// ─────────────────────────────────────────────

enum StudyType {
  QUERY
  FORM
  HYBRID
}

enum VariableType {
  CONTINUOUS
  DISCRETE
  DICHOTOMOUS
  NOMINAL
  ORDINAL
  TIME_TO_EVENT
}

enum VariableScope {
  CORE
  CUSTOM
}

enum AnalysisTest {
  KAPPA
  ICC
  CRONBACH
  LOGISTIC
  COX
  KAPLAN_MEIER
  T_TEST
  MANN_WHITNEY
  CHI_SQUARE
  FISHER
  ANOVA
  PEARSON
  SPEARMAN
  WILCOXON
  KRUSKAL
}

enum RiskFactorLabel {
  RISK_FACTOR
  PROTECTIVE_FACTOR
  NEUTRAL
}

model ResearchStudy {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  createdBy      String    @map("created_by")
  queryId        String?   @map("query_id") // V4: nullable for FORM studies
  studyType      StudyType @default(QUERY) @map("study_type") // V4: QUERY | FORM | HYBRID

  name             String
  description      String?
  status           StudyStatus @default(DRAFT)
  cachedPatientIds Json        @default("[]") @map("cached_patient_ids")
  cachedAt         DateTime?   @map("cached_at")
  patientCount     Int         @default(0) @map("patient_count")
  analyses         Json        @default("[]")
  publicationRef   String?     @map("publication_ref")
  frozenAt         DateTime?   @map("frozen_at")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization          Organization          @relation(fields: [organizationId], references: [id])
  query                 ResearchQuery?        @relation(fields: [queryId], references: [id])
  notifications         StudyNotification[]
  variables             StudyVariable[]
  subjects              StudySubject[]
  analysisRuns          StatisticalAnalysis[]
  variableTemplateLinks StudyVariableLink[]

  @@index([organizationId, status])
  @@index([organizationId, createdBy])
  @@index([queryId])
  @@index([organizationId, studyType, status])
  @@map("research_studies")
}

// ─────────────────────────────────────────────
// RESEARCH V4 — Form Builder models (REQ-FB-001 through REQ-FB-012)
// Analysis-oriented variables: StudySubject.values is JSONB+GIN (coherent
// with Patient.importedData, ClinicalScale.scores, ResearchStudy.analyses).
// Editing a VariableTemplate does NOT break existing studies — the
// StudyVariableLink snapshot stays immutable (REQ-FB-002).
// ─────────────────────────────────────────────

// Variable de estudio (analysis-oriented) — REQ-FB-001
model StudyVariable {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  studyId        String        @map("study_id")
  name           String
  label          String
  type           VariableType
  scope          VariableScope @default(CUSTOM)
  unit           String?
  required       Boolean       @default(false)
  isCore         Boolean       @default(false) @map("is_core")
  position       Int           @default(0)
  options        Json? // { values: [{value,label}] } NOMINAL/ORDINAL/DICHOTOMOUS
  range          Json? // { min, max, step } CONTINUOUS/DISCRETE
  parentId       String?       @map("parent_id") // descomposición compuesta
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  parent        StudyVariable?      @relation("VariableChildren", fields: [parentId], references: [id])
  children      StudyVariable[]     @relation("VariableChildren")
  study         ResearchStudy       @relation(fields: [studyId], references: [id], onDelete: Cascade)
  templateLinks StudyVariableLink[]

  @@index([studyId, position])
  @@index([organizationId, type])
  @@map("study_variables")
}

// Plantilla reusable (biblioteca de la organización) — REQ-FB-002
model VariableTemplate {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  createdBy      String       @map("created_by")
  name           String
  description    String?
  type           VariableType
  unit           String?
  options        Json?
  range          Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  links        StudyVariableLink[]

  @@unique([organizationId, name])
  @@map("variable_templates")
}

// Snapshot inmutable: editar plantilla no rompe estudios — REQ-FB-002
model StudyVariableLink {
  templateId String @map("template_id")
  studyId    String @map("study_id")
  studyVarId String @map("study_variable_id")

  template VariableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  study    ResearchStudy    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  variable StudyVariable    @relation(fields: [studyVarId], references: [id], onDelete: Cascade)

  @@id([templateId, studyVarId])
  @@index([studyId])
  @@map("study_variable_links")
}

// Registro de paciente en estudio form-based — REQ-FB-006
model StudySubject {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  studyId        String   @map("study_id")
  patientId      String?  @map("patient_id") // FK opcional
  patientNhc     String   @map("patient_nhc") // texto para entry manual
  values         Json     @default("{}") // { varId: value } validado por tipo
  autoFillMap    Json     @default("{}") @map("auto_fill_map") // { varId: 'patient.age' } snapshot EHR
  enrolledBy     String   @map("enrolled_by")
  enrolledAt     DateTime @default(now()) @map("enrolled_at")
  updatedAt      DateTime @updatedAt

  study        ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id])
  Organization Organization  @relation(fields: [organizationId], references: [id])

  @@unique([studyId, patientId])
  @@index([organizationId, studyId])
  @@index([values], type: Gin) // GIN para queries analíticas
  @@map("study_subjects")
}

// Trazabilidad de análisis — REQ-FB-012
model StatisticalAnalysis {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  studyId        String           @map("study_id")
  test           AnalysisTest
  variableIds    String[]         @map("variable_ids")
  params         Json             @default("{}")
  statistic      Float?
  pValue         Float?           @map("p_value")
  ci95           Json?            @map("ci_95") // { lower, upper }
  effectSize     Json?            @map("effect_size") // { or, hr, name }
  n              Int
  riskLabel      RiskFactorLabel? @map("risk_label")
  executedAt     DateTime         @default(now()) @map("executed_at")

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, executedAt])
  @@index([organizationId, test, executedAt])
  @@map("statistical_analyses")
}

model StudyNotification {
  id              String    @id @default(uuid())
  studyId         String    @map("study_id")
  organizationId  String    @map("organization_id")
  userId          String    @map("user_id")
  newPatientCount Int       @default(0) @map("new_patient_count")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now())

  study ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("study_notifications")
}

// ─────────────────────────────────────────────
// PATIENT COLLECTION MEMBER (Phase 12)
// ─────────────────────────────────────────────

model PatientCollectionMember {
  collectionId String   @map("collection_id")
  patientId    String   @map("patient_id")
  addedAt      DateTime @default(now()) @map("added_at")
  addedBy      String   @map("added_by")
  notes        String?

  collection PatientCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  patient    Patient           @relation(fields: [patientId], references: [id])

  @@id([collectionId, patientId])
  @@index([collectionId])
  @@index([patientId])
  @@map("patient_collection_members")
}

model Allergy {
  id             String @id @default(uuid())
  organizationId String
  patientId      String

  substance     String // Nombre del alérgeno (ej: "Amoxicilina", "Látex")
  substanceCode String? // Código SNOMED CT del alérgeno si disponible
  reaction      String? // Descripción de la reacción
  severity      AllergySeverity @default(MODERATE)
  status        AllergyStatus   @default(ACTIVE)
  onsetDate     DateTime?
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@map("allergies")
}

model Consultation {
  id             String @id @default(uuid())
  organizationId String
  patientId      String

  date        DateTime
  type        ConsultationType @default(FIRST_VISIT)
  physicianId String // userId del médico que realiza la consulta

  // Contenido clínico
  chiefComplaint String // Motivo de consulta
  currentIllness String? // Enfermedad actual / anamnesis

  // Exploración física ORL (JSONB flexible)
  physicalExam Json?

  // Diagnóstico
  assessment     String? // Impresión diagnóstica en texto libre
  diagnosisCodes Json? // [{ system: "ICD10"|"SNOMED", code, description, type: "primary"|"secondary" }]

  // Plan
  plan           String? // Plan de tratamiento en texto libre
  procedureCodes Json? // [{ system: "ICD10PCS"|"SNOMED", code, description }]

  // Follow-up
  followUpDate  DateTime?
  followUpNotes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String
  updatedBy String?

  patient             Patient              @relation(fields: [patientId], references: [id])
  scales              ClinicalScale[]
  reports             Report[]
  imagingStudies      ImagingStudy[]
  billingTransactions BillingTransaction[]

  @@index([organizationId])
  @@index([organizationId, patientId])
  @@index([organizationId, date])
  @@index([organizationId, physicianId])
  @@map("consultations")
}

model ClinicalScale {
  id             String  @id @default(uuid())
  organizationId String
  patientId      String
  consultationId String? // Opcional: puede existir sin consulta asociada

  scaleType ClinicalScaleType
  date      DateTime          @default(now())

  // Puntuaciones específicas de la escala (JSONB)
  scores Json

  notes     String?
  total     Int // Server-calculated total (BR-SCA-002: never trust client-sent total)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String? // userId who last modified the scale
  auditLog  Json?
  deletedAt DateTime? // Soft delete

  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, scaleType])
  @@map("clinical_scales")
}

model Surgery {
  id             String @id @default(uuid())
  organizationId String
  patientId      String
  physicianId    String // userId del cirujano principal

  // Datos del procedimiento
  date           DateTime
  status         SurgeryStatus @default(SCHEDULED)
  procedureType  String // Nombre del procedimiento (ej: "Septoplastia + CENS bilateral")
  procedureCodes Json? // [{ system: "ICD10PCS"|"SNOMED", code, description }]

  // Clasificación anestésica
  asa            AsaClassification?
  anesthesiaType String? // "General" | "Local" | "Sedación" | "Regional"

  // Pre-operatorio
  preOpNotes     String?
  preOpChecklist Json? // { bloodwork: bool, consent: bool, fasting: bool, ... }

  // Intraoperatorio
  duration      Int? // Duración en minutos
  technique     Json? // Notas de técnica quirúrgica (JSONB flexible por tipo de cirugía)
  findings      String? // Hallazgos intraoperatorios
  complications String?

  // Post-operatorio
  postOpNotes    String?
  postOpProtocol Json? // Protocolo de revisiones postoperatorias

  // Outcome
  outcome String?

  // Audit
  editReason String? // Required for edits in terminal states
  auditLog   Json? // [{ action, performedBy, performedAt, details, fieldDiffs }]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String
  updatedBy String?

  patient             Patient              @relation(fields: [patientId], references: [id])
  imagingStudies      ImagingStudy[]
  reports             Report[]
  billingTransactions BillingTransaction[]

  @@index([organizationId])
  @@index([organizationId, patientId])
  @@index([organizationId, date])
  @@index([organizationId, physicianId])
  @@map("surgeries")
}

model ImagingStudy {
  id             String  @id @default(uuid())
  organizationId String
  patientId      String
  surgeryId      String? // Opcional: puede vincularse a una cirugía
  consultationId String? // Opcional: puede vincularse a una consulta

  type        ImagingStudyType
  date        DateTime
  description String?

  // Anotaciones clínicas sobre el estudio
  findings String?
  labels   Json? // [{ label: string, coordinates?: {...} }]

  // Archivo(s) almacenados en R2
  files Json @default("[]")

  // Seven Categories — DICOM/DICOMweb metadata (spec §5)
  // Private R2 storage; identifiers are DICOM-compatible but never expose source file publicly.
  dicomStudyInstanceUid  String?
  dicomSeriesInstanceUid String?
  dicomSopInstanceUid    String?
  dicomModality          String?
  dicomStorageKey        String? // R2 key for DICOM data (private, never public)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String

  patient      Patient       @relation(fields: [patientId], references: [id])
  surgery      Surgery?      @relation(fields: [surgeryId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, type])
  @@index([dicomStudyInstanceUid])
  @@map("imaging_studies")
}

model PendingDeletion {
  id             String    @id @default(uuid())
  organizationId String
  entityType     String // "ImagingStudy" — polymorphic
  entityId       String // ID of the ImagingStudy
  fileKey        String // R2 key of the file to delete
  scheduledAt    DateTime  @default(now()) // now() + retention period (10 years)
  processedAt    DateTime? // Set when physical deletion completes

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([entityId])
  @@map("pending_deletions")
}

model MedicationPrescription {
  id             String  @id @default(uuid())
  organizationId String
  patientId      String
  consultationId String? // Consulta en la que se prescribió
  physicianId    String

  drugName         String // Nombre del medicamento
  drugCode         String? // Código ATC o CN (Código Nacional)
  activeIngredient String? // Principio activo
  dosage           String // Ej: "500mg"
  frequency        String // Ej: "cada 8 horas"
  route            String? // Ej: "oral", "tópico nasal", "IV"
  form             String? // Ej: "comprimidos", "spray nasal"

  startDate DateTime
  endDate   DateTime? // null = tratamiento crónico
  duration  String? // Descripción textual: "10 días", "3 meses"

  status                MedicationStatus @default(ACTIVE)
  instructions          String? // Instrucciones especiales para el paciente
  reason                String? // Indicación / diagnóstico que motiva la prescripción
  discontinuationReason String? // BR-MED-003: Required when transitioning to DISCONTINUED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String
  updatedBy String? // userId who last modified the prescription
  auditLog  Json?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, status])
  @@map("medication_prescriptions")
}

model Report {
  id             String @id @default(uuid())
  organizationId String
  patientId      String
  physicianId    String

  type   ReportType
  status ReportStatus @default(DRAFT)

  // Fuente del informe (polimórfico)
  sourceType String? // "consultation" | "surgery" | "manual"
  sourceId   String? // ID de la consulta o cirugía origen

  // Contenido
  title   String
  content String // Texto del informe (Markdown o texto plano)

  // Codificación clínica incluida en el informe
  diagnosisCodes Json? // [{ system, code, description, type }]
  procedureCodes Json? // [{ system, code, description }]

  // Generación IA
  aiGenerated  Boolean @default(false)
  aiModel      String? // "claude-sonnet-4-20250514"
  aiPromptHash String? // Hash del prompt usado (para reproducibilidad y auditoría)

  // PDF generado
  pdfUrl         String? // URL firmada del PDF en R2
  pdfGeneratedAt DateTime?

  // Firma
  signedAt DateTime?
  signedBy String? // userId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String
  updatedBy String?

  patient      Patient       @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [sourceId], references: [id], map: "report_consultation_fk")
  surgery      Surgery?      @relation(fields: [sourceId], references: [id], map: "report_surgery_fk")

  @@index([organizationId])
  @@index([organizationId, patientId])
  @@index([organizationId, status])
  @@map("reports")
}

// ─────────────────────────────────────────────
// AUDIT & COMPLIANCE
// ─────────────────────────────────────────────

model AuditLog {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  action     String // "CREATE" | "UPDATE" | "DELETE" | "VIEW" | "EXPORT" | "LOGIN"
  entityType String // "Patient" | "Consultation" | "Surgery" | etc.
  entityId   String? // ID del registro afectado

  // Cambios realizados (para UPDATE)
  changes Json?

  // Contexto de la petición
  ipAddress String?
  userAgent String?
  requestId String? // Para correlación de logs

  timestamp DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  // Audit log NUNCA tiene soft delete — es inmutable por definición
  @@index([organizationId, timestamp])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId])
  @@map("audit_logs")
}

model ConsentRecord {
  id             String @id @default(uuid())
  organizationId String
  patientId      String

  consentType ConsentType
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime? // null = consentimiento activo

  // Documento firmado (almacenado en R2)
  documentUrl   String?
  signatureData Json? // { method: "digital"|"ink", hash: string, ip: string }

  // Quién recogió el consentimiento
  collectedBy String // userId

  notes String?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, consentType])
  @@map("consent_records")
}

// ─────────────────────────────────────────────
// BILLING & AI USAGE TRACKING
// ─────────────────────────────────────────────

// Per-organization monthly AI report generation counter (BR-REP-009 enforcement).
// yearMonth is "YYYY-MM". Unique constraint guarantees one row per org per month.
model AiReportUsage {
  id             String   @id @default(uuid())
  organizationId String
  yearMonth      String // "2026-07"
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
  @@map("ai_report_usage")
}

// Idempotency table for Stripe webhook events. eventId is the Stripe event id (PK).
// Survives Stripe retries and app restarts: a duplicate event is a no-op.
model ProcessedStripeEvent {
  eventId     String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ─────────────────────────────────────────────
// BILLING TRANSACTIONS (clinical/financial)
// ─────────────────────────────────────────────

model BillingTransaction {
  id             String        @id @default(uuid())
  organizationId String
  patientId      String?
  consultationId String?
  surgeryId      String?
  amount         Float
  type           BillingType   @default(OTHER)
  status         BillingStatus @default(PENDING)
  description    String?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  surgery      Surgery?      @relation(fields: [surgeryId], references: [id])

  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("billing_transactions")
}

// ─────────────────────────────────────────────
// DOCTOR SCHEDULE (weekly slots)
// ─────────────────────────────────────────────

model DoctorSchedule {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  dayOfWeek      Int // 0=Sun..6=Sat
  startTime      String // "09:00"
  endTime        String // "17:00"
  slotDuration   Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId, dayOfWeek])
  @@index([organizationId, userId])
  @@map("doctor_schedules")
}

// ─────────────────────────────────────────────
// PHARMA CONTACTS & INTERACTIONS
// ─────────────────────────────────────────────

model PharmaContact {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  company        String
  role           String?
  email          String?
  phone          String?
  notes          String?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  interactions PharmaInteraction[]

  @@index([organizationId])
  @@index([organizationId, company])
  @@map("pharma_contacts")
}

model PharmaInteraction {
  id             String          @id @default(uuid())
  organizationId String
  contactId      String
  date           DateTime        @default(now())
  type           InteractionType @default(OTHER)
  notes          String?
  followUpNeeded Boolean         @default(false)
  createdAt      DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  contact      PharmaContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, date])
  @@index([organizationId, date])
  @@map("pharma_interactions")
}

// ─────────────────────────────────────────────
// CALENDAR (Phase 3) — persisted events and external-sync tokens
// Manual + public-booking + external-mirror events live here; clinical
// ( Surgery / Consultation / PharmaInteraction ) events are virtual and
// mapped at query time by the calendar source mapper service.
// ─────────────────────────────────────────────

model CalendarEvent {
  id                 String              @id @default(uuid())
  organizationId     String
  userId             String // owner doctor
  source             CalendarEventSource
  sourceId           String? // FK to source record (string, not enforced — virtual too)
  externalCalendarId String? // provider-side event ID; nullable, for sync tracking
  title              String
  description        String?
  startDateTime      DateTime
  endDateTime        DateTime
  status             CalendarEventStatus @default(CONFIRMED)
  isPublic           Boolean             @default(false) // visible on public booking page
  contactName        String? // public-booking only
  contactEmail       String? // public-booking only
  metadata           Json?
  lastSyncedAt       DateTime?
  deletedAt          DateTime? // soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, startDateTime])
  @@index([organizationId, startDateTime])
  @@index([externalCalendarId])
  @@index([userId, isPublic])
  @@map("calendar_events")
}

model CalendarToken {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  provider       CalendarProvider
  accessToken    String // AES-256-GCM encrypted at rest (Phase 4)
  refreshToken   String? // AES-256-GCM encrypted at rest (Phase 4)
  expiresAt      DateTime
  scope          String?
  syncToken      String? // incremental sync cursor (Google/Microsoft)
  caldavUrl      String? // iCloud
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_tokens")
}

// ─────────────────────────────────────────────
// SEVEN CATEGORIES — Clinical Record Models
// (SDD patient-seven-categories)
// ─────────────────────────────────────────────

// History (Antecedentes) — spec §2
// Typed key/value entries with provenance; independently queryable.
model PatientHistoryEntry {
  id             String           @id @default(uuid())
  organizationId String
  patientId      String
  entryType      HistoryEntryType
  key            String // e.g. "Penicilina", "Tabaquismo", "Madre: diabetes"
  value          String // free-text value
  sourceType     String // "manual" | "import" | "dual-write"
  sourceId       String? // FK to source record if dual-written
  authorId       String // userId who recorded this
  recordedAt     DateTime         @default(now())
  reviewState    ReviewState      @default(UNREVIEWED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, entryType])
  @@map("patient_history_entries")
}

// Current Illness (Enfermedad actual) — spec §3
// Structured symptoms, temporal data, and narrative linked to source consultation.
model CurrentIllnessEntry {
  id             String        @id @default(uuid())
  organizationId String
  patientId      String
  symptoms       String // structured symptom description
  durationValue  Int? // numeric duration
  durationUnit   DurationUnit?
  onset          DateTime? // when symptoms started
  evolution      String? // how symptoms evolved
  narrative      String? // supporting free-text narrative
  consultationId String? // source consultation (nullable for standalone entries)
  sourceType     String        @default("manual")
  authorId       String
  recordedAt     DateTime      @default(now())
  reviewState    ReviewState   @default(UNREVIEWED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, createdAt])
  @@map("current_illness_entries")
}

// Physical Exam Template — spec §4
// Versioned specialty templates; records pin the template version + schema snapshot.
model PhysicalExamTemplate {
  id             String   @id @default(uuid())
  organizationId String
  specialty      String // e.g. "ORL", "Cardiología"
  version        Int // immutable once published
  fields         Json // [{ key, label, type, required, options? }]
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, specialty, version])
  @@index([organizationId, specialty])
  @@map("physical_exam_templates")
}

// Physical Exam Record — spec §4
// Pins template version + schema snapshot so historical exams remain renderable.
model PhysicalExamRecord {
  id                     String      @id @default(uuid())
  organizationId         String
  patientId              String
  templateId             String
  templateVersion        Int // pinned at creation time
  templateSchemaSnapshot Json // immutable snapshot of template fields at record time
  values                 Json // { fieldKey: value }
  customFindings         Json        @default("[]") // [{ label, value }] for non-predefined findings
  consultationId         String?
  sourceType             String      @default("manual")
  authorId               String
  recordedAt             DateTime    @default(now())
  reviewState            ReviewState @default(UNREVIEWED)
  createdAt              DateTime    @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, createdAt])
  @@index([templateId, templateVersion])
  @@map("physical_exam_records")
}

// Lab Report — spec §5
// PDF in private S3; OCR output starts UNREVIEWED; only CONFIRMED values become clinical data.
model LabReport {
  id                 String      @id @default(uuid())
  organizationId     String
  patientId          String
  s3Key              String // private S3 key for the PDF
  fileName           String // original file name
  ocrPayload         Json? // raw OCR extraction; null until processed
  overallReviewState ReviewState @default(UNREVIEWED)
  sourceType         String      @default("ocr")
  authorId           String // who uploaded / initiated OCR
  recordedAt         DateTime    @default(now())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  patient Patient     @relation(fields: [patientId], references: [id])
  results LabResult[]

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, overallReviewState])
  @@map("lab_reports")
}

// Lab Result — individual values extracted from a LabReport
// Each result has its own review state; only CONFIRMED results are clinical data.
model LabResult {
  id             String      @id @default(uuid())
  labReportId    String
  index          Int // position in the OCR extraction
  name           String // test name (e.g. "Hemoglobin")
  value          String // result value
  unit           String?
  referenceRange String?
  reviewState    ReviewState @default(UNREVIEWED)
  reviewedBy     String? // userId who confirmed/rejected
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  labReport LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  @@index([labReportId])
  @@index([labReportId, reviewState])
  @@map("lab_results")
}

// Diagnosis — spec §6
// First-class entity with CIE-10-ES/SNOMED code, status lifecycle, and clinical variables.
model Diagnosis {
  id             String              @id @default(uuid())
  organizationId String
  patientId      String
  system         DiagnosisCodeSystem
  code           String // e.g. "J32.0"
  description    String // snapshot of description at creation (decoupled from catalog updates)
  catalogVersion String // e.g. "2024" — the catalog version used for validation
  status         DiagnosisStatus     @default(ACTIVE)
  variables      Json                @default("{}") // clinical variables { severity, side, ... }
  consultationId String?
  sourceType     String              @default("manual")
  authorId       String
  recordedAt     DateTime            @default(now())
  resolvedAt     DateTime? // set when status → RESOLVED
  discardedAt    DateTime? // set when status → DISCARDED
  discardedBy    String? // userId who discarded
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([organizationId, patientId])
  @@index([organizationId, patientId, status])
  @@index([organizationId, system, code])
  @@map("diagnoses")
}
