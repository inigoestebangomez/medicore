# ============================================================
# MediCore — Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials
# ============================================================

# ─────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host.neon.tech/medicore?sslmode=require"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# REDIS (Upstash)
# ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────
# CLOUD (Cloudflare R2)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="medicore-documents"
R2_PUBLIC_URL="https://documents.medicore.app"

# ─────────────────────────────────────────────
# AI (Anthropic Claude)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# ─────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@medicore.app"

# ─────────────────────────────────────────────
# ANALYTICS (PostHog)
# ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─────────────────────────────────────────────
# SENTRY
# ─────────────────────────────────────────────
SENTRY_DSN=""